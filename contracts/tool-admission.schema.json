{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamedev-skills.dev/contracts/tool-admission.schema.json",
  "title": "Game studio tool admission policy",
  "description": "Structural policy contract. Runtime rejects revoked policies, binds the exact distribution/version/transport/action tier, and freezes a trusted authorization verifier during executor bootstrap. Policy authenticity, bootstrap isolation, and OS sandboxing remain deployment responsibilities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_version", "server_id", "server_version", "distribution_sha256", "transport", "auth_required", "project_root", "allowed_tools", "allowed_egress_hosts", "action_tier"],
  "properties": {
    "policy_version": {"type": "string", "minLength": 1},
    "server_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "server_version": {"type": "string", "minLength": 1},
    "distribution_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "transport": {"enum": ["stdio", "http", "sse"]},
    "auth_required": {"type": "boolean"},
    "project_root": {"type": "string", "minLength": 1},
    "allowed_tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "allowed_egress_hosts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "action_tier": {"enum": ["read", "write", "execute", "deploy"]},
    "revoked": {"type": "boolean", "default": false}
  }
}
