{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamedev-skills.dev/contracts/workflow-transition.schema.json",
  "title": "Game studio workflow transition receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "from_state", "to_state", "actor", "verifier", "artifact_hash", "evidence_hashes", "idempotency_key", "policy_version", "timestamp", "recovery"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "from_state": {"type": "string"},
    "to_state": {"type": "string"},
    "actor": {"type": "string", "minLength": 1},
    "verifier": {"type": "string", "minLength": 1},
    "artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "idempotency_key": {"type": "string", "minLength": 8},
    "policy_version": {"type": "string", "minLength": 1},
    "timestamp": {"type": "integer", "minimum": 0},
    "recovery": {"enum": ["none", "retry", "rollback", "compensate"]},
    "approval_receipt": {"$ref": "approval-receipt.schema.json"}
  },
  "description": "Structural contract. Runtime additionally validates the state graph, trusted verifier membership, idempotency and signed release approval."
}
